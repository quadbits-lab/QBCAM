{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/target",
      "!**/.venv",
      "!**/.hutch",
      "!**/.kilo",
      "!**/build",
      "!**/*.md",
      "!**/*.yml",
      "!**/*.yaml",
      "!**/.cottontail-tmp",
      "!**/.zcode",
      "!**/.mimosa",
      "!**/.pytest_cache",
      "!**/*.icon"
    ]
  }
}
